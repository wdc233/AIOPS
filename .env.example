# Database Configuration
DATABASE__HOST=localhost
DATABASE__PORT=9030
DATABASE__USER=root
DATABASE__PASSWORD=
DATABASE__DATABASE=aiops
DATABASE__POOL_SIZE=10
DATABASE__ECHO=false

# LLM Configuration
LLM__PROVIDER=openai
LLM__API_KEY=
LLM__BASE_URL=
LLM__MODEL=gpt-4
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=2048
LLM__HEARTBEAT_MODEL=gpt-3.5-turbo
LLM__HEARTBEAT_TEMPERATURE=0.3

# SSH Configuration
SSH__TIMEOUT=30
SSH__COMMAND_TIMEOUT=300
SSH__MAX_RETRIES=3
SSH__RETRY_DELAY=1.0

# Prometheus Configuration
PROMETHEUS__URL=http://localhost:9090
PROMETHEUS__TIMEOUT=10

# Grafana Configuration
GRAFANA__URL=http://localhost:3000
GRAFANA__API_KEY=
GRAFANA__TIMEOUT=10

# WebSocket Configuration
WEBSOCKET__HOST=0.0.0.0
WEBSOCKET__PORT=8765
WEBSOCKET__PING_INTERVAL=30
WEBSOCKET__PING_TIMEOUT=10

# Scheduler Configuration
SCHEDULER__HEARTBEAT_INTERVAL=1800
SCHEDULER__CRON_ENABLED=true
SCHEDULER__MAX_CONCURRENT_TASKS=10

# Agent Configuration
AGENT__AGENT_ID=aiops-agent-001
AGENT__NAME=AIOPS Agent
AGENT__DEBUG=false
AGENT__LOG_LEVEL=INFO